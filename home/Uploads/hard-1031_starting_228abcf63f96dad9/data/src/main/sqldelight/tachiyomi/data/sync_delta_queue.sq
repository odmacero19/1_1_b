-- Outbox of local changes that still have to be uploaded by the delta sync engine.
--
-- Rows are written by SQLite triggers (see mangas.sq, chapters.sq, mangas_categories.sq) whenever a
-- row becomes dirty, i.e. whenever its `version` is bumped while `is_syncing = 0`.
--
-- Lifecycle of an entry:
--   PENDING   -> waiting to be uploaded. At most ONE pending entry exists per (table_name, record_id),
--                further changes to the same row are coalesced into it.
--   IN_FLIGHT -> claimed by a push run. Deleted on acknowledgement, turned back into PENDING on failure.
--   FAILED    -> parked after a permanent rejection / too many attempts. Re-queued by requeueFailed.
CREATE TABLE sync_delta_queue(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    table_name TEXT NOT NULL CHECK (table_name IN ('mangas', 'chapters')),
    record_id INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'IN_FLIGHT', 'FAILED')),
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT
);

-- Coalesces repeated edits of the same row while it is waiting for upload.
CREATE UNIQUE INDEX sync_delta_queue_pending_record_index
ON sync_delta_queue(table_name, record_id)
WHERE status = 'PENDING';

CREATE INDEX sync_delta_queue_status_index
ON sync_delta_queue(status, _id);

---------------------------------------------------------------------------------------------------
-- Queue management
---------------------------------------------------------------------------------------------------

enqueue:
INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id, status)
VALUES (:tableName, :recordId, 'PENDING');

-- Moves the oldest pending entries to IN_FLIGHT. Must be run in the same transaction as getInFlight.
claimPending:
UPDATE sync_delta_queue
SET status = 'IN_FLIGHT'
WHERE _id IN (
    SELECT _id
    FROM sync_delta_queue
    WHERE status = 'PENDING'
    ORDER BY _id
    LIMIT :limit
);

getInFlight:
SELECT _id, table_name, record_id, attempts
FROM sync_delta_queue
WHERE status = 'IN_FLIGHT'
ORDER BY _id;

deleteByIds:
DELETE FROM sync_delta_queue
WHERE _id IN :ids;

-- A newer PENDING entry for the same record already covers the in-flight one (the row is re-read from
-- the mangas/chapters table on every push), so the in-flight one can simply be dropped.
dropSupersededInFlight:
DELETE FROM sync_delta_queue
WHERE _id IN :ids
AND status = 'IN_FLIGHT'
AND EXISTS (
    SELECT 1
    FROM sync_delta_queue AS newer
    WHERE newer.table_name = sync_delta_queue.table_name
    AND newer.record_id = sync_delta_queue.record_id
    AND newer.status = 'PENDING'
);

releaseInFlight:
UPDATE sync_delta_queue
SET status = 'PENDING', attempts = attempts + 1, last_error = :error
WHERE _id IN :ids
AND status = 'IN_FLIGHT';

-- Used when the attempt never reached a server (offline, DNS, timeout): it must not use up the retry budget.
releaseInFlightWithoutPenalty:
UPDATE sync_delta_queue
SET status = 'PENDING', last_error = :error
WHERE _id IN :ids
AND status = 'IN_FLIGHT';

parkInFlight:
UPDATE sync_delta_queue
SET status = 'FAILED', attempts = attempts + 1, last_error = :error
WHERE _id IN :ids
AND status = 'IN_FLIGHT';

parkExhausted:
UPDATE sync_delta_queue
SET status = 'FAILED'
WHERE status = 'PENDING'
AND attempts >= :maxAttempts;

-- Crash recovery: anything still IN_FLIGHT when a push run starts belongs to a run that died.
dropSupersededStaleInFlight:
DELETE FROM sync_delta_queue
WHERE status = 'IN_FLIGHT'
AND EXISTS (
    SELECT 1
    FROM sync_delta_queue AS newer
    WHERE newer.table_name = sync_delta_queue.table_name
    AND newer.record_id = sync_delta_queue.record_id
    AND newer.status = 'PENDING'
);

recoverStaleInFlight:
UPDATE sync_delta_queue
SET status = 'PENDING'
WHERE status = 'IN_FLIGHT';

dropFailedCoveredByPending:
DELETE FROM sync_delta_queue
WHERE status = 'FAILED'
AND EXISTS (
    SELECT 1
    FROM sync_delta_queue AS other
    WHERE other.table_name = sync_delta_queue.table_name
    AND other.record_id = sync_delta_queue.record_id
    AND other.status = 'PENDING'
);

dropFailedDuplicates:
DELETE FROM sync_delta_queue
WHERE status = 'FAILED'
AND EXISTS (
    SELECT 1
    FROM sync_delta_queue AS other
    WHERE other.table_name = sync_delta_queue.table_name
    AND other.record_id = sync_delta_queue.record_id
    AND other.status = 'FAILED'
    AND other._id > sync_delta_queue._id
);

requeueFailed:
UPDATE sync_delta_queue
SET status = 'PENDING', attempts = 0, last_error = NULL
WHERE status = 'FAILED';

-- A remote change won against the local one, the local change must not be uploaded any more.
deletePendingForRecord:
DELETE FROM sync_delta_queue
WHERE table_name = :tableName
AND record_id = :recordId
AND status = 'PENDING';

countByStatus:
SELECT count(*)
FROM sync_delta_queue
WHERE status = :status;

-- Highest id ever handed out to a queue entry. It only grows when something is newly enqueued (retries keep
-- their id), which is what the scheduler uses to wake the push job.
--
-- The LIMIT 0 sub-selects always evaluate to 0 without reading any row. They only make the query depend on the
-- tables the triggers are fired by, so an observing Flow is re-run after user edits even if the listener
-- bookkeeping does not follow rows that are inserted into sync_delta_queue by a trigger.
latestEntryId:
SELECT coalesce(max(_id), 0)
    + coalesce((SELECT 1 FROM mangas LIMIT 0), 0)
    + coalesce((SELECT 1 FROM chapters LIMIT 0), 0)
    + coalesce((SELECT 1 FROM mangas_categories LIMIT 0), 0)
FROM sync_delta_queue;

---------------------------------------------------------------------------------------------------
-- Reading the dirty rows (push)
---------------------------------------------------------------------------------------------------

getMangasByIds:
SELECT *
FROM mangas
WHERE _id IN :ids;

getChaptersByIds:
SELECT *
FROM chapters
WHERE _id IN :ids;

getCategoryNamesByMangaId:
SELECT C.name
FROM categories C
JOIN mangas_categories MC
ON MC.category_id = C._id
WHERE MC.manga_id = :mangaId
AND C._id > 0
ORDER BY C.sort;

---------------------------------------------------------------------------------------------------
-- Applying remote changes (pull)
--
-- Every statement that writes synced columns sets is_syncing = 1 so that the version triggers stay
-- silent, and clearIsSyncing is executed before the surrounding transaction commits.
---------------------------------------------------------------------------------------------------

getCategoryIdsByNames:
SELECT _id
FROM categories
WHERE name IN :names
AND _id > 0;

applyRemoteManga:
UPDATE mangas
SET artist = :artist,
    author = :author,
    description = :description,
    genre = :genre,
    title = :title,
    status = :status,
    thumbnail_url = :thumbnailUrl,
    favorite = :favorite,
    initialized = :initialized,
    viewer = :viewerFlags,
    chapter_flags = :chapterFlags,
    date_added = :dateAdded,
    update_strategy = :updateStrategy,
    notes = :notes,
    memo = :memo,
    version = :version,
    is_syncing = 1
WHERE _id = :mangaId;

clearMangaIsSyncing:
UPDATE mangas
SET is_syncing = 0
WHERE _id = :mangaId;

applyRemoteChapter:
UPDATE chapters
SET name = :name,
    scanlator = :scanlator,
    read = :read,
    bookmark = :bookmark,
    last_page_read = :lastPageRead,
    chapter_number = :chapterNumber,
    source_order = :sourceOrder,
    date_upload = :dateUpload,
    memo = :memo,
    version = :version,
    is_syncing = 1
WHERE _id = :chapterId;

clearChapterIsSyncing:
UPDATE chapters
SET is_syncing = 0
WHERE _id = :chapterId;
